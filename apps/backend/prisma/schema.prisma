generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String            @id @default(uuid())
  name                  String
  email                 String            @unique
  passwordHash          String            @map("password_hash")
  role                  Role
  active                Boolean           @default(false)
  createdAt             DateTime          @default(now()) @map("created_at")

  refreshTokenHash      String?           @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime?         @map("refresh_token_expires_at")

  auditLogEntries       AuditLog[]
  versionsUploaded      DocumentVersion[] @relation("VersionUploader")
  documentsOwned        Document[]        @relation("DocumentOwner")

  @@map("users")
}

model Document {
  id                String             @id @default(uuid())
  title             String
  category          String
  docType           DocType            @map("doc_type")
  status            String             @default("draft")
  ownerId           String             @map("owner_id")
  confidentiality   Confidentiality    @default(PUBLIC)
  issueDate         DateTime?          @map("issue_date")
  expiryDate        DateTime?          @map("expiry_date")
  reviewDate        DateTime?          @map("review_date")
  createdAt         DateTime           @default(now()) @map("created_at")
  auditLogEntries   AuditLog[]
  tags              DocumentTag[]
  versions          DocumentVersion[]
  owner             User               @relation("DocumentOwner", fields: [ownerId], references: [id])
  notificationsSent NotificationSent[]

  @@index([status])
  @@index([expiryDate])
  @@map("documents")
}

model DocumentVersion {
  id              String   @id @default(uuid())
  documentId      String   @map("document_id")
  driveFileId     String   @map("drive_file_id")
  driveRevisionId String?  @map("drive_revision_id")
  versionNumber   Int      @map("version_number")
  uploadedById    String   @map("uploaded_by")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")
  changeNote      String?  @map("change_note")
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy      User     @relation("VersionUploader", fields: [uploadedById], references: [id])

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model Tag {
  id   String        @id @default(uuid())
  name String        @unique
  docs DocumentTag[]

  @@map("tags")
}

model DocumentTag {
  documentId String   @map("document_id")
  tagId      String   @map("tag_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("document_tags")
}

model AuditLog {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  action     String
  documentId String?   @map("document_id")
  timestamp  DateTime  @default(now())
  details    String?
  document   Document? @relation(fields: [documentId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([documentId])
  @@map("audit_log")
}

model NotificationSent {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  threshold  Int
  sentAt     DateTime @default(now()) @map("sent_at")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, threshold])
  @@map("notifications_sent")
}

enum Role {
  HEAD_OF_BIDDING
  BIDDING_OFFICER
}

enum DocType {
  BANK_REF_LETTER
  BID_TECHNICAL_DOCS
  CAC
  CLIENTS_COMPANIES
  COMPANY_PROFILE
  DIRECTORS_FOLDER
  EXPERIENCE
  FINANCIAL_AUDITED_DOCUMENT
  HSE
  IN_HOUSE_PERSONNEL_DETAILS
  INSURANCE
  IRR
  ITF
  MOU
  NCEC
  NIMASA
  NIPEX_RENEWAL
  NMDPRA
  NOGIC
  NPA
  NSITF
  NUPRC
  ORGANOGRAM
  PENCOM
  TAX
  OTHER
}

enum Confidentiality {
  PUBLIC
  RESTRICTED
  CONFIDENTIAL
}
